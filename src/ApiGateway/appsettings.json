{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "basket": {
        "ClusterId": "basket",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/basket/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/basket" } ]
      }
    },
    "Clusters": {
      "catalog": {
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/live" }
        },
        "Destinations": {
          "catalog-1": { "Address": "http://localhost:5101" }
        }
      },
      "basket": {
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/live" }
        },
        "Destinations": {
          "basket-1": { "Address": "http://localhost:5201" }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
