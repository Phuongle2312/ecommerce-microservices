<Project Sdk="Microsoft.NET.Sdk">

  <!-- Wire contracts shared between services: gRPC protos now, integration events in phase 2.
       Keep this project free of business logic so services stay independently deployable. -->

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\catalog.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
